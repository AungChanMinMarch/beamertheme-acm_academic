%% =====================================================================
%%  beamerthemeacm_academic.sty                         v1.1 (2026/10/28)
%%  A clean academic Beamer theme with three layouts:
%%    1. title page     -- two logos, purpose line, title, subtitle,
%%                         author block (left) and advisor block (right)
%%    2. section page   -- "Section x of n", section title, description,
%%                         and every section listed along the bottom
%%    3. content page   -- sidebar (logo A, short contents, logo B) and a
%%                         footer "Author · Short title · 3 / 23"
%%
%%  USAGE
%%    \documentclass[aspectratio=169]{beamer}
%%    \usetheme{acm_academic}            % or \usetheme[nosectionpages]{acm_academic}
%%
%%  THEME COMMANDS (all optional, put them in the preamble)
%%    \purpose{Thesis Proposal · Master of Engineering}  red line above the title
%%    \advisor{Name}       or  \advisor[Supervisor]{Name}       (label optional)
%%    \coadvisor{Name}     or  \coadvisor[Co-supervisor]{Name}
%%    \addtitleinfo{Committee: Dr. X}   extra line in the bottom-right block
%%    \logoA{file}   \logoB{file}       default files: logo_A, logo_B (next to
%%                                      the .tex); not found = no logo drawn;
%%                                      \logoA{} / \logoB{} = no logo
%%    \logoBcaption{My\\University}     text next to logo B in the sidebar
%%    \sectiondescription{...}          one line under the title of a section
%%                                      page -- write it right AFTER \section
%%    \themecolors{primary=5C2468, accent=A51C30, highlight=F9CC5C}
%%                  HTML hex codes, any subset of the keys:
%%                  primary   section page background, block titles
%%                  accent    purpose line, current section, bullets
%%                  highlight "Section x of n" and current item on section page
%%                  (also: text, muted, paper, sidebar, line, soft)
%%    \themelabels{section=Section, appendix=Appendix, of=of,
%%                 advisor=Advisor, coadvisor=Co-advisor}   words used by the theme
%%
%%  STANDARD BEAMER COMMANDS THE THEME USES
%%    \title[short title for footer]{Full title}   \subtitle{...}
%%    \author{...}  \institute{...}  \date{...}  \maketitle
%%    \section[short name for navigation]{Full section title}
%%
%%  Compile twice (pdfLaTeX, XeLaTeX or LuaLaTeX): the section list, the
%%  "of n" count, page totals and section descriptions come from the
%%  previous run, as with any Beamer table of contents.
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeacm_academic}[2026/10/28 v1.1 acm_academic Beamer theme]

\RequirePackage{iftex}
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\RequirePackage{fix-cm}   % scalable math fonts: no size warnings at odd sizes

% ---------------------------------------------------------------- options
\newif\ifacm@sectionpages \acm@sectionpagestrue
\DeclareOptionBeamer{sectionpages}{\acm@sectionpagestrue}
\DeclareOptionBeamer{nosectionpages}{\acm@sectionpagesfalse}
\ProcessOptionsBeamer

% =====================================================================
%  FONTS  -- IBM Plex Sans (text), IBM Plex Serif (titles), Plex Mono
% =====================================================================
\newif\ifacm@plex
\ifPDFTeX
  \IfFileExists{plex-sans.sty}{%
    \RequirePackage[T1]{fontenc}%
    \RequirePackage{plex-sans}%
    \RequirePackage{plex-serif}%
    \IfFileExists{plex-mono.sty}{\RequirePackage[scale=0.95]{plex-mono}}{}%
    \acm@plextrue
  }{\PackageWarningNoLine{beamerthemeacm_academic}%
      {IBM Plex fonts (package 'plex') not found.\MessageBreak
       Falling back to the default fonts}}
\else % XeLaTeX / LuaLaTeX
  \RequirePackage{fontspec}
  \IfFontExistsTF{IBMPlexSans-Regular.otf}{%
    \setsansfont{IBMPlexSans}[
      Extension      = .otf,
      UprightFont    = *-Regular,
      ItalicFont     = *-Italic,
      BoldFont       = *-Bold,
      BoldItalicFont = *-BoldItalic,
      FontFace       = {sb}{n}{Font = *-SemiBold},
      FontFace       = {sb}{it}{Font = *-SemiBoldItalic}]%
    \setmainfont{IBMPlexSerif}[
      Extension      = .otf,
      UprightFont    = *-Regular,
      ItalicFont     = *-Italic,
      BoldFont       = *-Bold,
      BoldItalicFont = *-BoldItalic,
      FontFace       = {sb}{n}{Font = *-SemiBold},
      FontFace       = {sb}{it}{Font = *-SemiBoldItalic}]%
    \IfFontExistsTF{IBMPlexMono-Regular.otf}{%
      \setmonofont{IBMPlexMono}[
        Extension      = .otf,
        Scale          = 0.95,
        UprightFont    = *-Regular,
        ItalicFont     = *-Italic,
        BoldFont       = *-Bold,
        BoldItalicFont = *-BoldItalic]}{}%
    \acm@plextrue
  }{\PackageWarningNoLine{beamerthemeacm_academic}%
      {IBM Plex OpenType fonts not found.\MessageBreak
       Falling back to the default fonts}}
\fi

% semibold weight (falls back to bold without IBM Plex)
\ifacm@plex
  \newcommand\acmsemibold{\fontseries{sb}\selectfont}
\else
  \newcommand\acmsemibold{\bfseries}
\fi

% letter-spaced text (used for the red purpose line and "SECTION 1 OF 6")
\ifXeTeX
  \ifacm@plex
    \newcommand\acmtracked[1]{{\addfontfeatures{LetterSpace=13}#1}}
  \else
    \newcommand\acmtracked[1]{#1}
  \fi
\else
  \AtEndPreamble{\@ifpackageloaded{microtype}{}{\RequirePackage{microtype}}}
  \newcommand\acmtracked[1]{\textls*[130]{#1}}
\fi

