% =====================================================================
%  HELPERS
% =====================================================================
% find a graphics file: tries the name as given, then common extensions,
% also inside \graphicspath folders.  Result in \acm@found (or \relax).
\def\acm@exts{,.pdf,.png,.jpg,.jpeg,.eps,.PDF,.PNG,.JPG,.JPEG}
\newcommand\acm@findfile[1]{%
  \let\acm@found\relax
  \def\acm@trydir##1{%
    \@for\acm@ext:=\acm@exts\do{%
      \ifx\acm@found\relax
        \IfFileExists{##1#1\acm@ext}{\edef\acm@found{##1#1\acm@ext}}{}%
      \fi}}%
  \acm@trydir{}%
  \ifx\acm@found\relax
    \ifdefined\Ginput@path
      \expandafter\@tfor\expandafter\acm@dir\expandafter:\expandafter=\Ginput@path\do{%
        \ifx\acm@found\relax\expandafter\acm@trydir\expandafter{\acm@dir}\fi}%
    \fi
  \fi}

% \acm@logostate{A or B}: \acm@state = 0 no logo, 1 file found (\acm@found),
% 2 placeholder (file set with \logoA/\logoB but not found)
\newcommand\acm@logostate[1]{%
  \edef\acm@logoname{\csname acm@logo#1file\endcsname}%
  \ifx\acm@logoname\@empty
    \def\acm@state{0}%
  \else
    \acm@findfile{\acm@logoname}%
    \ifx\acm@found\relax
      \ifnum\csname acm@logo#1set\endcsname=1
        \def\acm@state{2}%
        \PackageWarning{beamerthemeacm_academic}{Logo file `\acm@logoname' not found}%
      \else
        \def\acm@state{0}%
      \fi
    \else
      \def\acm@state{1}%
    \fi
  \fi}

% \acm@logo{A or B}{height}{max width}{placeholder width}
\newcommand\acm@logo[4]{%
  \acm@logostate{#1}%
  \ifcase\acm@state\relax
  \or
    \includegraphics[height=#2,width=#3,keepaspectratio]{\acm@found}%
  \or
    {\setlength\fboxsep{0pt}\setlength\fboxrule{0.4pt}%
     \fcolorbox{acmLine}{acmSidebar}{\hbox to #4{\hss\vbox to #2{\vss
       \hbox{\fontsize{4pt}{5pt}\selectfont\color{acmMutedLight}\detokenize\expandafter{\acm@logoname}}\vss}\hss}}}%
  \fi}

% ignore the commands Beamer stores for subsections and mini frames
\newcommand\acm@silencenav{%
  \def\slideentry##1##2##3##4##5##6{}%
  \def\beamer@subsectionentry##1##2##3##4##5{}%
  \def\beamer@subsubsectionentry##1##2##3##4##5##6{}}

% section number shown in navigation: 1, 2, ... (A1, A2, ... in the appendix)
\newcommand\acm@numlabel[1]{\ifbeamer@inappendix A\fi#1}

% position of the current section within the current part, and the total
\newcommand\acm@countsections{%
  \global\acm@secidx=0 \global\acm@sectot=0
  \begingroup
    \acm@silencenav
    \def\sectionentry##1##2##3##4##5{%
      \ifnum##5=\c@part
        \global\advance\acm@sectot by 1
        \ifnum##1=\c@section \global\acm@secidx=\acm@sectot\fi
      \fi}%
    \dohead
  \endgroup
  \ifnum\acm@secidx=0 \global\acm@secidx=\c@section\fi % first compilation
}

% =====================================================================
%  CONTENT PAGE: sidebar + footer
% =====================================================================
% one entry of the sidebar contents: #1 number, #2 title, #3 page, #4 current?
\newcommand\acm@sidebaritem[4]{%
  \setbox\acm@boxb\vtop{%
    \hsize=\dimexpr\acm@sidebarwd-\acm@sidepad-\acm@toctextx-2.4mm\relax
    \raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
    \ifnum#4=1 \usebeamercolor[fg]{section in sidebar}\acmsemibold
    \else      \usebeamercolor[fg]{section in sidebar shaded}\fi
    \setbox\acm@boxc\hbox{#1\ }%
    \hangindent=\wd\acm@boxc \hangafter=1
    \leavevmode\vrule width\z@ height\dimexpr.698em+.6mm\relax depth\z@
    \unhcopy\acm@boxc#2\vrule width\z@ height\z@ depth.75mm\par}%
  \hbox{%
    \ifnum#4=1
      {\usebeamercolor[fg]{section in sidebar}%
       \vrule width\acm@tocbarwd height\ht\acm@boxb depth\dp\acm@boxb}%
      \hskip\dimexpr\acm@toctextx-\acm@tocbarwd\relax
    \else
      \hskip\acm@toctextx
    \fi
    \hyperlink{Navigation#3}{\box\acm@boxb}}}

\newcommand\acm@buildsidebartoc{%
  \setbox\acm@boxa\vbox{%
    \usebeamerfont{section in sidebar}%
    \acm@navidx=0
    \acm@silencenav
    \def\sectionentry##1##2##3##4##5{%
      \ifnum##5=\c@part
        \advance\acm@navidx by 1
        \ifnum\acm@navidx>1 \nointerlineskip\vskip\acm@tocgap\fi
        \ifnum\c@section=##1
          \acm@sidebaritem{\acm@numlabel{\the\acm@navidx}}{##2}{##3}{1}%
        \else
          \acm@sidebaritem{\acm@numlabel{\the\acm@navidx}}{##2}{##3}{0}%
        \fi
      \fi}%
    \dohead}%
  % shrink the list if it would run into logo B
  \acm@dima=\dimexpr\paperheight-\acm@logoBbottom-\acm@logoBht-4mm-\acm@toctop\relax
  \ifdim\dimexpr\ht\acm@boxa+\dp\acm@boxa\relax>\acm@dima
    \setbox\acm@boxa\hbox{\resizebox*{!}{\acm@dima}{\box\acm@boxa}}%
  \fi}

\defbeamertemplate*{sidebar left}{acm}{%
  \ifx\acm@pagekind\acm@kind@n
    \acm@buildsidebartoc
    \nointerlineskip
    \hbox{\begin{tikzpicture}[overlay]
      \usebeamercolor{sidebar panel}%
      \fill[bg] (-1pt,1pt) rectangle (\acm@sidebarwd,-\paperheight-1pt);
      {\usebeamercolor{sidebar border}%
       \fill[fg] (\acm@sidebarwd-0.4pt,1pt) rectangle (\acm@sidebarwd,-\paperheight-1pt);}
      \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (\acm@sidepad,-\acm@logoAtop)
        {\acm@logo{A}{\acm@logoAht}{\dimexpr\acm@sidebarwd-2\acm@sidepad\relax}{18mm}};
      \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (\acm@sidepad,-\acm@toctop)
        {\box\acm@boxa};
      \node[anchor=south west,inner sep=0pt,outer sep=0pt] (acm-logoB)
        at (\acm@sidepad,-\paperheight+\acm@logoBbottom)
        {\acm@logo{B}{\acm@logoBht}{\dimexpr\acm@sidebarwd-2\acm@sidepad\relax}{\acm@logoBht}};
      \ifx\acm@logoBcaption\@empty\else
        \node[anchor=west,inner sep=0pt,outer sep=0pt,align=left,
              font={\usebeamerfont{logo caption}\usebeamercolor[fg]{logo caption}}]
          at ([xshift=\acm@captiongap,yshift=-0.3mm]acm-logoB.east) {\acm@logoBcaption};
      \fi
    \end{tikzpicture}}%
  \fi}

\defbeamertemplate*{footline}{acm}{%
  \ifx\acm@pagekind\acm@kind@n
    \setbox\acm@footbox\hbox to \paperwidth{%
      \hskip\dimexpr\acm@sidebarwd+\acm@margin\relax
      \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
      \ifx\beamer@shortauthor\@empty\else
        \insertshortauthor\ \textperiodcentered\ \fi
      \ifx\beamer@shorttitle\@empty\else
        \insertshorttitle\ \textperiodcentered\ \fi
      \acm@pagenumber
      \hfil}%
  \else
    \setbox\acm@footbox\hbox{}%
  \fi
  % footer baseline sits \acm@footbase above the bottom of the page
  \vbox to \acm@footheight{\vfil\copy\acm@footbox\vskip\dimexpr\acm@footbase-\dp\acm@footbox\relax}}

% "3 / 23"; appendix frames are counted separately ("2 / 4")
\newcommand\acm@pagenumber{%
  \ifdefined\insertmainframenumber
    \ifbeamer@inappendix
      \insertframenumberinappendix\ /\ \insertappendixframenumber
    \else
      \insertframenumber\ /\ \insertmainframenumber
    \fi
  \else
    \insertframenumber\ /\ \inserttotalframenumber
  \fi}

% ---------------------------------------------------------- frame title
\defbeamertemplate*{frametitle}{acm}{%
  {\usebeamerfont{frametitle}\global\acm@ftstrut=.875em}% room above 1st baseline
  \nointerlineskip
  \vskip\dimexpr\acm@ft@base-\acm@ftstrut\relax
  \hbox{\vtop{%
    \hsize=\textwidth \raggedright
    \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}%
    \leavevmode\vrule width\z@ height\acm@ftstrut depth\z@\insertframetitle\par
    \ifx\insertframesubtitle\@empty\else
      \lineskiplimit=-\maxdimen
      \usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
      \vskip\dimexpr4.4mm-\baselineskip\relax
      \insertframesubtitle\par
    \fi}}%
  \vskip2.6mm}
\setbeamertemplate{frametitle continuation}[from second][(cont.)]

% =====================================================================
%  TITLE PAGE
% =====================================================================
\newcommand\acm@infoline[1]{#1\par}

\newcommand\acm@drawtitlepage{%
  % widths
  \acm@dima=\dimexpr\paperwidth-2\acm@tp@padx\relax           % content width
  % ---------------- bottom left: author + institute
  \setbox\acm@boxa\vbox{%
    \hsize=.5\acm@dima \raggedright \lineskiplimit=-\maxdimen
    \ifx\beamer@shortauthor\@empty\else
      {\usebeamerfont{author}\usebeamercolor[fg]{author}%
       \leavevmode\vrule width\z@ height.76em depth\z@\insertauthor\par}%
    \fi
    \ifx\insertinstitute\@empty\else
      {\usebeamerfont{institute}\usebeamercolor[fg]{institute}%
       \vskip\dimexpr4.2mm-\baselineskip\relax
       \insertinstitute\par}%
    \fi}%
  % ---------------- bottom right: advisors, extra lines, date
  \setbox\acm@boxb\vbox{%
    \hsize=.5\acm@dima \raggedleft \lineskiplimit=-\maxdimen
    \usebeamerfont{advisor}\usebeamercolor[fg]{advisor}%
    \ifx\acm@advisor\@empty\else
      \leavevmode\vrule width\z@ height.76em depth\z@
      \acm@advisorlabel: \acm@advisor\par\fi
    \ifx\acm@coadvisor\@empty\else \acm@coadvisorlabel: \acm@coadvisor\par\fi
    \acm@titleinfo
    \setbox\acm@boxc\hbox{\insertdate}%
    \ifdim\wd\acm@boxc>\z@
      {\usebeamerfont{date}\usebeamercolor[fg]{date}%
       \ifvmode\ifdim\prevdepth>-1000pt \vskip.85mm\fi\fi
       \insertdate\par}%
    \fi}%
  % ---------------- middle: purpose, title, subtitle
  \setbox\acm@boxc\vbox{%
    \hsize=\dimexpr\acm@dima-13.3mm\relax \raggedright \lineskiplimit=-\maxdimen
    \ifx\acm@purpose\@empty\else
      {\usebeamerfont{purpose}\usebeamercolor[fg]{purpose}%
       \acmtracked{\MakeUppercase{\acm@purpose}}\par}%
      \usebeamerfont{title}\vskip\dimexpr9.32mm-\baselineskip\relax
    \fi
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
    \ifx\insertsubtitle\@empty\else
      {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}%
       \hsize=.625\paperwidth
       \vskip\dimexpr6.8mm-\baselineskip\relax
       \insertsubtitle\par}%
    \fi}%
  % ---------------- vertical positions (measured from the top)
  \acm@dimb=\dimexpr\paperheight-\acm@tp@bottombase\relax       % bottom baselines
  \ifdim\ht\acm@boxa>\ht\acm@boxb \acm@dimc=\ht\acm@boxa \else \acm@dimc=\ht\acm@boxb \fi
  \acm@dimc=\dimexpr\acm@dimb-\acm@dimc-\acm@tp@rulegap\relax    % rule
  % fit the middle block between the logos and the rule
  \acm@dima=\dimexpr\acm@dimc-\acm@tp@pady-\acm@tp@logoht-8mm\relax
  \ifdim\dimexpr\ht\acm@boxc+\dp\acm@boxc\relax>\acm@dima
    \setbox\acm@boxc\hbox{\resizebox*{!}{\acm@dima}{\box\acm@boxc}}%
  \fi
  \begin{tikzpicture}
    \useasboundingbox (0pt,0pt) rectangle (\paperwidth,-\paperheight);
    \usebeamercolor{background canvas}%
    \fill[bg] (-1pt,1pt) rectangle (\paperwidth+1pt,-\paperheight-1pt);% 1pt bleed
    % logo B and the divider only move right of logo A when logo A exists
    \acm@logostate{A}\let\acm@stateA\acm@state
    \acm@logostate{B}\let\acm@stateB\acm@state
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] (acm-tA) at (\acm@tp@padx,-\acm@tp@pady)
      {\acm@logo{A}{\acm@tp@logoht}{60mm}{22mm}};
    \ifnum\acm@stateA=0
      \node[anchor=north west,inner sep=0pt,outer sep=0pt] (acm-tB) at (\acm@tp@padx,-\acm@tp@pady)
        {\acm@logo{B}{\acm@tp@logoht}{60mm}{\acm@tp@logoht}};
    \else
      \node[anchor=west,inner sep=0pt,outer sep=0pt] (acm-tB)
        at ([xshift=2*\acm@tp@logogap+0.4pt]acm-tA.east)
        {\acm@logo{B}{\acm@tp@logoht}{60mm}{\acm@tp@logoht}};
      \ifnum\acm@stateB>0
        {\usebeamercolor{logo divider}%
         \fill[fg] ([xshift=\acm@tp@logogap,yshift=-0.4*\acm@tp@logoht]acm-tA.east)
            rectangle ++(0.4pt,0.8*\acm@tp@logoht);}
      \fi
    \fi
    \node[anchor=west,inner sep=0pt,outer sep=0pt]
      at (\acm@tp@padx,{-(\acm@tp@pady+\acm@tp@logoht+\acm@dimc)/2-0.3mm})
      {\box\acm@boxc};
    \ifdim\dimexpr\ht\acm@boxa+\ht\acm@boxb\relax>\z@
      {\usebeamercolor{title page rule}%
       \fill[fg] (\acm@tp@padx,-\acm@dimc) rectangle (\paperwidth-\acm@tp@padx,-\acm@dimc-0.4pt);}
    \fi
    \node[anchor=base west,inner sep=0pt,outer sep=0pt] at (\acm@tp@padx,-\acm@dimb) {\box\acm@boxa};
    \node[anchor=base east,inner sep=0pt,outer sep=0pt] at (\paperwidth-\acm@tp@padx,-\acm@dimb) {\box\acm@boxb};
  \end{tikzpicture}}

\defbeamertemplate*{title page}{acm}{\gdef\acm@pagekind{t}\vfill}

% \maketitle outside a frame makes its own (plain, unnumbered) frame
\def\maketitle{\ifbeamer@inframe\titlepage\else
  \frame[plain,noframenumbering]{\titlepage}\fi}

% =====================================================================
%  SECTION PAGE
% =====================================================================
\newcommand\acm@sectionlabel{%
  \ifbeamer@inappendix\acm@lbl@appendix\else\acm@lbl@section\fi
  \ \the\acm@secidx\ifnum\acm@sectot>0 \ \acm@lbl@of\ \the\acm@sectot\fi}

% the section names of the current part, separated by #1 (some glue)
\newcommand\acm@navitems[1]{%
  \acm@navidx=0
  \acm@silencenav
  \def\sectionentry##1##2##3##4##5{%
    \ifnum##5=\c@part
      \advance\acm@navidx by 1
      \ifnum\acm@navidx>1 #1\fi
      \hyperlink{Navigation##3}{\hbox{%
        \ifnum\c@section=##1
          \usebeamercolor[fg]{section page nav current}\acmsemibold
        \else
          \usebeamercolor[fg]{section page nav}%
        \fi
        \acm@numlabel{\the\acm@navidx}\ ##2}}%
    \fi}%
  \dohead}

% one row spread edge to edge; if the names do not fit they wrap onto more
% rows (all rows spread, except a ragged last row)
\newcommand\acm@buildsectionnav{%
  \setbox\acm@boxa\vbox{%
    \hsize=\dimexpr\paperwidth-2\acm@sp@pad\relax
    \usebeamerfont{section page nav}%
    \setbox\acm@boxd\hbox{\acm@navitems{\hskip\acm@sp@navgap\relax}}%
    \parindent=\z@ \leftskip=\z@ \rightskip=\z@
    \ifdim\wd\acm@boxd>\hsize \parfillskip=\z@ plus 1fill\relax \else \parfillskip=\z@ \fi
    \tolerance=10000 \hbadness=10000 \lineskiplimit=-\maxdimen
    \leavevmode\acm@navitems{\hskip\acm@sp@navgap plus 1fil\relax}\par}}

\newcommand\acm@drawsectionpage{%
  \acm@countsections
  \acm@buildsectionnav
  \setbox\acm@boxb\vbox{%
    \hsize=\dimexpr\paperwidth-2\acm@sp@pad-13.3mm\relax \raggedright
    \lineskiplimit=-\maxdimen
    {\usebeamerfont{section title}\usebeamercolor[fg]{section page}\secname\par}%
    \ifcsname acm@desc@\the\c@section\endcsname
      {\usebeamerfont{section page description}\usebeamercolor[fg]{section page description}%
       \hsize=.7\paperwidth
       \vskip\dimexpr6.6mm-\baselineskip\relax
       \csname acm@desc@\the\c@section\endcsname\par}%
    \fi}%
  \begin{tikzpicture}
    \useasboundingbox (0pt,0pt) rectangle (\paperwidth,-\paperheight);
    \usebeamercolor{section page}%
    \fill[bg] (-1pt,1pt) rectangle (\paperwidth+1pt,-\paperheight-1pt);% 1pt bleed
    \node[anchor=base west,inner sep=0pt,outer sep=0pt] at (\acm@sp@pad,-\acm@sp@labelbase)
      {\usebeamerfont{section page label}\usebeamercolor[fg]{section page label}%
       \acmtracked{\MakeUppercase{\acm@sectionlabel}}};
    \node[anchor=west,inner sep=0pt,outer sep=0pt] at (\acm@sp@pad,-0.5075*\paperheight)
      {\box\acm@boxb};
    \node[anchor=base west,inner sep=0pt,outer sep=0pt]
      at (\acm@sp@pad,-\paperheight+\acm@sp@navbase) {\box\acm@boxa};
  \end{tikzpicture}}

\defbeamertemplate*{section page}{acm}{\gdef\acm@pagekind{s}\vfill}

\ifacm@sectionpages
  \AtBeginSection[]{\begin{frame}[plain,noframenumbering]\sectionpage\end{frame}}
\fi

% =====================================================================
%  BACKGROUND: draws the whole title page / section page
% =====================================================================
\defbeamertemplate*{background canvas}{acm}{%
  \ifx\acm@pagekind\acm@kind@t
    \acm@drawtitlepage
  \else\ifx\acm@pagekind\acm@kind@s
    \acm@drawsectionpage
  \else
    \usebeamercolor{background canvas}%
    \ifbeamercolorempty[bg]{background canvas}{}%
      {\color{bg}\vrule width\paperwidth height\paperheight}%
  \fi\fi}

