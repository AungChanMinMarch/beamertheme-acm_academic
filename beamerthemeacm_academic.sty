% \themecolors{key=HEX, ...}: colours are looked up when used, so this works
% anywhere in the preamble.  "soft" defaults to primary mixed with white.
\pgfkeys{/acm/colors/.is family, /acm/colors,
  primary/.code   = {\definecolor{acmPurple}{HTML}{#1}%
                     \colorlet{acmLavender}{acmPurple!35!white}},
  accent/.code    = {\definecolor{acmRed}{HTML}{#1}},
  highlight/.code = {\definecolor{acmGold}{HTML}{#1}%
                     \colorlet{acmGoldDark}{acmGold!55!black}},
  text/.code      = {\definecolor{acmInk}{HTML}{#1}},
  muted/.code     = {\definecolor{acmMuted}{HTML}{#1}\colorlet{acmMutedLight}{acmMuted}},
  paper/.code     = {\definecolor{acmPaper}{HTML}{#1}},
  sidebar/.code   = {\definecolor{acmSidebar}{HTML}{#1}},
  line/.code      = {\definecolor{acmLine}{HTML}{#1}},
  soft/.code      = {\definecolor{acmLavender}{HTML}{#1}}}
