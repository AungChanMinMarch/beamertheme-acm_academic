% \sectiondescription{text}: stored in the .aux file, shown on the section
% page of the current section from the next compilation on.
\def\acm@secdesc#1#2{\global\@namedef{acm@desc@#1}{#2}}
\newcommand\sectiondescription[1]{%
  \if@filesw
    \immediate\write\@auxout{\string\acm@secdesc{\the\c@section}{\unexpanded{#1}}}%
  \fi}
\AtBeginDocument{%
  \if@filesw\immediate\write\@auxout{\string\providecommand\string\acm@secdesc[2]{}}\fi}

